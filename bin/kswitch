#!/usr/bin/env bash
#
# kswitch - Switch the default kubeconfig (a symlink) and its default namespace
#

# shellcheck source=../lib/common.sh
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

show_help() {
  cat <<EOF
${BOLD}Usage:${NC} kswitch [OPTIONS] [CONFIG_NAME] [-n NAMESPACE]

Make ${BLUE}$KT_CONFIG_DIR/CONFIG_NAME$KT_SUFFIX${NC} the default kubeconfig by pointing the
${BLUE}$KT_DEFAULT_LINK${NC} symlink to it. kubectl, helm, k9s... then use it.

${BOLD}Options:${NC}
  ${CYAN}-h, --help${NC}            Show this help message and exit
  ${CYAN}-V, --version${NC}         Show the version and exit
  ${CYAN}-l, --list${NC}            List available kubeconfig files
  ${CYAN}-c, --current${NC}         Show the current default config and its namespace
  ${CYAN}-r, --remove${NC}          Remove the symlink (no default config)
  ${CYAN}-n, --namespace NS${NC}    Set the default namespace of the (new) current config.
                        Saved in the kubeconfig file itself.

${BOLD}Examples:${NC}
  ${YELLOW}kswitch prod${NC}                  # Use prod$KT_SUFFIX as default kubeconfig
  ${YELLOW}kswitch staging -n payments${NC}   # Switch to staging, default namespace 'payments'
  ${YELLOW}kswitch -n kube-system${NC}        # Change the namespace of the current config
  ${YELLOW}kswitch --current${NC}             # Show current config and namespace
EOF
}

list_configs() {
  local current name
  current=$(kt_current_default)
  echo "Available kubeconfig files:"
  mapfile -t names < <(kt_config_names)
  if [ ${#names[@]} -eq 0 ]; then
    echo "  No *$KT_SUFFIX files found in $KT_CONFIG_DIR"
    return 0
  fi
  for name in "${names[@]}"; do
    if [ "$name" = "$current" ]; then
      echo "  ${GREEN}$name${NC} (current default)"
    else
      echo "  $name"
    fi
  done
}

show_current() {
  local name ns
  if [ -L "$KT_DEFAULT_LINK" ]; then
    name=$(kt_current_default)
    ns=$(kt_context_field "$name" namespace)
    echo "Current default config: ${GREEN}$name${NC} -> $(kt_pretty_path "$(readlink "$KT_DEFAULT_LINK")")"
    echo "  Namespace: ${ns:-default}"
    kt_warn_kubeconfig_override
  elif [ -e "$KT_DEFAULT_LINK" ]; then
    echo "Current default config: regular file (not managed by kswitch)"
    echo "  File: $(kt_pretty_path "$KT_DEFAULT_LINK")"
  else
    echo "No default config ($KT_DEFAULT_LINK does not exist)"
  fi
}

remove_link() {
  if [ -L "$KT_DEFAULT_LINK" ]; then
    local name
    name=$(kt_current_default)
    rm -f "$KT_DEFAULT_LINK"
    echo "Removed symbolic link to $name, no default kubeconfig is set"
  elif [ -e "$KT_DEFAULT_LINK" ]; then
    kt_warn "$KT_DEFAULT_LINK is a regular file, not a symbolic link: left untouched"
    return 1
  else
    echo "No symbolic link found at $KT_DEFAULT_LINK"
  fi
}

switch_config() {
  local name="$1" path
  path=$(kt_config_path "$name")
  if ! kt_config_exists "$name"; then
    kt_error "config file $path not found"
    echo "Run 'kswitch --list' to see available configurations" >&2
    return 1
  fi
  if [ -e "$KT_DEFAULT_LINK" ] && [ ! -L "$KT_DEFAULT_LINK" ]; then
    kt_error "$KT_DEFAULT_LINK is a regular file; move it to a *$KT_SUFFIX file to use kswitch"
    return 1
  fi
  ln -sfn "$path" "$KT_DEFAULT_LINK" || { kt_error "failed to create symbolic link"; return 1; }
  echo "Switched default kubeconfig to: ${GREEN}$name${NC}"
  echo "  $(kt_pretty_path "$KT_DEFAULT_LINK") -> $(kt_pretty_path "$path")"
  kt_warn_kubeconfig_override
  kt_refresh_ns_cache_bg "$name"
}

# Set the default namespace of the current config, after checking it exists
set_namespace() {
  local ns="$1" name out ctx_ns
  if [ ! -L "$KT_DEFAULT_LINK" ]; then
    kt_error "no current config (run 'kswitch CONFIG_NAME -n $ns')"
    return 1
  fi
  name=$(kt_current_default)

  if out=$(kt_kubectl "$name" get namespace "$ns" -o name 2>&1); then
    :
  elif grep -q "NotFound" <<< "$out"; then
    kt_error "namespace '$ns' does not exist in $name"
    return 1
  elif grep -q "Forbidden" <<< "$out"; then
    # Namespace-scoped credentials: only their own namespace is usable
    ctx_ns=$(kt_context_field "$name" namespace)
    if [ -n "$ctx_ns" ] && [ "$ctx_ns" != "$ns" ]; then
      kt_error "$name credentials are limited to namespace '$ctx_ns'"
      return 1
    fi
  else
    kt_warn "cluster unreachable, cannot verify namespace '$ns' (saving it anyway)"
  fi

  if kubectl --kubeconfig "$(kt_config_path "$name")" config set-context --current --namespace="$ns" >/dev/null; then
    echo "Default namespace of $name set to: ${GREEN}$ns${NC}"
    [ -n "$CONFIG" ] || kt_warn_kubeconfig_override
  else
    kt_error "failed to set namespace"
    return 1
  fi
}

# Parse arguments
ACTION=""
CONFIG=""
NAMESPACE=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) show_help; exit 0 ;;
    -V|--version) kt_print_version kswitch; exit 0 ;;
    -l|--list) ACTION=list ;;
    -c|--current) ACTION=current ;;
    -r|--remove) ACTION=remove ;;
    -n|--namespace)
      shift
      [ -n "${1:-}" ] || { kt_error "-n requires a namespace"; exit 1; }
      NAMESPACE="$1"
      ;;
    --namespace=*) NAMESPACE="${1#*=}" ;;
    -*) kt_error "unknown option $1"; echo "Run 'kswitch --help' for usage" >&2; exit 1 ;;
    *)
      [ -n "$CONFIG" ] && { kt_error "only one CONFIG_NAME expected"; exit 1; }
      CONFIG="$1"
      ;;
  esac
  shift
done

kt_require_kubectl

if [ ! -d "$KT_CONFIG_DIR" ]; then
  kt_error "$KT_CONFIG_DIR directory not found"
  exit 1
fi

case "$ACTION" in
  list) list_configs; exit 0 ;;
  current) show_current; exit 0 ;;
  remove) remove_link; exit $? ;;
esac

if [ -z "$CONFIG" ] && [ -z "$NAMESPACE" ]; then
  list_configs
  exit 1
fi

if [ -n "$CONFIG" ]; then
  switch_config "$CONFIG" || exit 1
fi
if [ -n "$NAMESPACE" ]; then
  set_namespace "$NAMESPACE" || exit 1
fi
exit 0
